{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id>",
    "ClientId": "<gateway-client-id>",
    "Audience": "api://<gateway-client-id>"
  },
  "ReverseProxy": {
    "Routes": {
      "lead": {
        "ClusterId": "lead-cluster",
        "Match": { "Path": "/lead/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/lead" } ]
      },
      "complaints": {
        "ClusterId": "complaints-cluster",
        "Match": { "Path": "/complaints/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/complaints" } ]
      },
      "master": {
        "ClusterId": "master-cluster",
        "Match": { "Path": "/master/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/master" } ]
      },
      "appointments": {
        "ClusterId": "appointments-cluster",
        "Match": { "Path": "/appointments/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/appointments" } ]
      }
    },
    "Clusters": {
      "lead-cluster": { "Destinations": { "d1": { "Address": "http://lead-api:5001" } } },
      "complaints-cluster": { "Destinations": { "d1": { "Address": "http://complaints-api:5002" } } },
      "master-cluster": { "Destinations": { "d1": { "Address": "http://master-api:5003" } } },
      "appointments-cluster": { "Destinations": { "d1": { "Address": "http://serviceappointments-api:5004" } } }
    }
  }
}
